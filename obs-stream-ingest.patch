+def _resolve_live_start_offset(first_snapshot: dict | None, final_snapshot: dict, *,
+                               from_start_click: bool = False) -> float:
+    """Compute the start offset inside final_snapshot when capturing from the [Start] button click."""
+    if not from_start_click or first_snapshot is None:
+        return 0.0
+    final_duration = float(final_snapshot.get("duration") or 0.0)
+    if final_duration <= 0:
+        return 0.0
+    first_duration = float(first_snapshot.get("duration") or 0.0)
+    first_win = first_snapshot.get("window") or {}
+    final_win = final_snapshot.get("window") or {}
+    first_utc = first_win.get("start_utc")
+    final_utc = final_win.get("start_utc")
+    if isinstance(first_utc, (int, float)) and isinstance(final_utc, (int, float)):
+        start_edge_utc = float(first_utc) + first_duration
+        raw_offset = start_edge_utc - float(final_utc)
+    else:
+        raw_offset = first_duration
+    if raw_offset <= 0:
+        return 0.0
+    if raw_offset >= final_duration:
+        return max(0.0, final_duration - min(final_duration, 10.0))
+    return round(raw_offset, 3)
+
