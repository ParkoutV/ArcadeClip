+def _wait_poll(cancel: threading.Event, stop_event: threading.Event | None, seconds: float) -> bool:
+    """Sleep up to seconds; raise on cancel and return True immediately if stop_event is set."""
+    if stop_event is None:
+        if cancel.wait(seconds):
+            raise InterruptedError(tr('작업을 취소했습니다.'))
+        return False
+    deadline = time.monotonic() + max(0.0, float(seconds))
+    while True:
+        if cancel.is_set():
+            raise InterruptedError(tr('작업을 취소했습니다.'))
+        if stop_event.is_set():
+            return True
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return False
+        if cancel.wait(min(0.1, remaining)):
+            raise InterruptedError(tr('작업을 취소했습니다.'))
+
+
+def watch_youtube_stream(url: str, directory: Path, cancel: threading.Event, report, *,
+                         poll_seconds: float = 15.0, workers: int = 4,
+                         wait_for_end: bool = True, max_polls: int = 0,
+                         stop_event: threading.Event | None = None,
+                         from_start_click: bool = False) -> dict:
+    """Monitor a YouTube live or channel URL and download the session automatically."""
+    target = youtube_stream_target(url)
+    if type(workers) is not int or not 1 <= workers <= 16:
+        raise ValueError(tr('동시 다운로드 수는 1–16개로 지정해 주세요.'))
+    if not isinstance(poll_seconds, (int, float)) or not math.isfinite(poll_seconds) or not 1 <= poll_seconds <= 300:
+        raise ValueError(tr('감지 주기는 1–300초 사이로 지정해 주세요.'))
+
+    first_snapshot = None
+    last_snapshot = None
+    polls = 0
+
+    def _download_from_snapshot(snapshot: dict, *, stopped: bool = False) -> dict:
+        snap_duration = float(snapshot.get("duration") or 0.0)
+        start_sec = _resolve_live_start_offset(
+            first_snapshot, snapshot, from_start_click=from_start_click
+        )
+        path = download_section(
+            snapshot["url"], start_sec, snap_duration, directory, cancel, report,
+            snapshot=snapshot, workers=workers,
+        )
+        result = {"path": path, "metadata": snapshot, "start": start_sec, "end": snap_duration}
+        if stopped:
+            result["stopped"] = True
+        return result
+
+    while True:
+        if cancel.is_set():
+            raise InterruptedError(tr('작업을 취소했습니다.'))
+        stop_requested = stop_event is not None and stop_event.is_set()
+        polls += 1
+        if stop_requested:
+            report(tr('수신 정지 요청됨 · 현재 시점까지의 라이브 구간을 다운로드합니다…'))
