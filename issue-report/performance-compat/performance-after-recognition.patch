diff --git a/run/verify_analysis_options.py b/run/verify_analysis_options.py
new file mode 100644
--- /dev/null
+++ b/run/verify_analysis_options.py
@@ -0,0 +1,46 @@
+"""Short actual-source option matrix; no fallback may hide a failed GPU mode."""
+import ctypes
+import gc
+import json
+from pathlib import Path
+import sys
+import threading
+import time
+
+root = Path(__file__).resolve().parents[1]
